bug-reports: "https://github.com/carsonmagnuson/roborean/issues"
depends: [
  "ocaml"
  "dune" {>= "3.24"}
  "dream"
  "cohttp-lwt-unix"
  "yojson"
  "dotenv"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
